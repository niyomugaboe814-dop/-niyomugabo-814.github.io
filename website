<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Registration System</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #eef2f7;
    margin: 0;
}

.header {
    background: #2a5298;
    color: white;
    text-align: center;
    padding: 18px;
}

.container {
    max-width: 480px;
    margin: auto;
    background: white;
    padding: 20px;
    margin-top: 25px;
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

h2 {
    text-align: center;
}

input, select {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border-radius: 8px;
    border: 1px solid #ccc;
}

button {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    cursor: pointer;
}

.primary {
    background: #2a5298;
    color: white;
}

.success {
    background: #28a745;
    color: white;
}

.box {
    background: #f1f5ff;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 12px;
}

.amount {
    font-size: 26px;
    font-weight: bold;
    color: #28a745;
    text-align: center;
}

.hidden {
    display: none;
}

.note {
    text-align: center;
    font-size: 14px;
    color: gray;
}
</style>

</head>
<body>

<div class="header">
    <h1>Registration Portal</h1>
</div>

<div class="container">

<!-- STEP 1 -->
<div id="step1">
    <h2>Step 1: Kuzuza Ibisabwa / Fill Details</h2>

    <form id="form1">
        <input type="text" placeholder="Amazina (Full Name)" required>
        <input type="email" placeholder="Email Address" required>
        <input type="tel" placeholder="Phone Number" required>

        <select required>
            <option value="">Hitamo Payment Method / Select Method</option>
            <option>Mobile Money</option>
            <option>Airtel Money</option>
        </select>

        <button class="primary">Komeza / Continue</button>
    </form>
</div>

<!-- STEP 2 -->
<div id="step2" class="hidden">
    <h2>Step 2: Payment Required</h2>

    <div class="box">
        <p style="text-align:center;">Amafaranga yo kwiyandikisha / Registration Fee</p>
        <div class="amount">4750 RWF</div>
        <p class="note">Please complete payment to continue</p>
    </div>

    <button id="goPay" class="primary">Reba Aho Kwishyurira / View Payment</button>
</div>

<!-- STEP 3 -->
<div id="step3" class="hidden">
    <h2>Step 3: Kwishyura / Payment</h2>

    <div class="box">
        <p><b>Dial Code:</b> *182*1*1*0791885637# shyiramo umubare wibanga</p>
        <p><b>ibaruye kuri:</b> Niyomugabo Emmanuel</p>
    </div>

    <p class="note">Nyuma yo kwishyura, shyiramo proof (screen shoot ya sms)</p>

    <form id="form2">
        <input type="file" accept="image/*" required>
        <button class="primary">Ohereza / Submit Proof</button>
    </form>
</div>

<!-- STEP 4 -->
<div id="step4" class="hidden">
    <h2>Step 4: Byakunze / Success</h2>

    <div class="box">
        ✔ Kwiyandikisha byagenze neza / Registration successful<br>
        ✔ Payment verified
    </div>

    <p class="note">Komeza kuri Jotform kugirango ubone bonus / Continue for bonus</p>

    <a href="https://www.jotform.com/myaccount/partnership" target="_blank">
        <button class="success">Continue to Jotform</button>
    </a>
</div>

</div>

<script>

// STEP 1 → STEP 2
document.getElementById("form1").addEventListener("submit", function(e){
    e.preventDefault();
    document.getElementById("step1").classList.add("hidden");
    document.getElementById("step2").classList.remove("hidden");
});

// STEP 2 → STEP 3
document.getElementById("goPay").addEventListener("click", function(){
    document.getElementById("step2").classList.add("hidden");
    document.getElementById("step3").classList.remove("hidden");
});

// STEP 3 → STEP 4
document.getElementById("form2").addEventListener("submit", function(e){
    e.preventDefault();
    document.getElementById("step3").classList.add("hidden");
    document.getElementById("step4").classList.remove("hidden");
});

</script>

</body>
</html>
